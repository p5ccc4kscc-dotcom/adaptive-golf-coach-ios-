{
  "expo": {
    "name": "BadGolfer",
    "slug": "badgolfer",
    "version": "0.1.0",
    "scheme": "badgolfer",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.adaptivegolfcoach",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "BadGolfer"
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "android": {
      "package": "com.example.adaptivegolfcoach",
      "adaptiveIcon": {
        "backgroundColor": "#0A3A28",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "BadGolfer",
      "shortName": "BadGolfer",
      "description": "BadGolfer — private, evidence-based golf coaching. Browser preview.",
      "backgroundColor": "#F4F6F3",
      "lang": "en-GB"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "BadGolfer — a private, evidence-based golf coaching app."
  }
}
