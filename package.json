{
  "name": "badgolfer",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "babel-preset-expo": "~57.0.16",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "fake-indexeddb": "^6.2.6",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "sql.js": "^1.15.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "postinstall": "node scripts/copy-sqljs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:ui": "jest --selectProjects ui",
    "export:web": "expo export --platform web && node scripts/finalize-web.mjs",
    "serve:web": "node scripts/serve-dist.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:pages": "EXPO_BASE_URL=/adaptive-golf-coach-ios- expo export --platform web && EXPO_BASE_URL=/adaptive-golf-coach-ios- node scripts/finalize-web.mjs --spa-fallback",
    "test:e2e:pages": "BASE_PATH=/adaptive-golf-coach-ios- playwright test",
    "brand:icons": "node scripts/render-brand-assets.mjs"
  },
  "private": true,
  "overrides": {
    "expo-font": "~57.0.4"
  }
}
